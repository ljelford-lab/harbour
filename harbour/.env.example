# Copy the values you choose/collect into Netlify → Site configuration →
# Environment variables. This file is just a reference — Netlify doesn't
# read it automatically, and it's git-ignored so you never accidentally
# commit real secrets in it.

# Made up by you — unlocks the app itself
HARBOUR_SECRET=

# From resend.com → API Keys
RESEND_API_KEY=

# Where the daily brief should be sent
HARBOUR_EMAIL_TO=you@example.com

# Who it's sent from — onboarding@resend.dev works with no setup,
# or your own verified sender once you've set that up in Resend
HARBOUR_EMAIL_FROM=onboarding@resend.dev

# Netlify Blobs needs no environment variables or manual setup — it's
# available automatically to any function once the site is deployed.
